FROM maven:3.9.9-eclipse-temurin-17

WORKDIR /app

ARG USER_ID=1000
ARG GROUP_ID=1000

ENV TZ=America/Santiago
ENV MAVEN_CONFIG=

RUN apt-get update && \
    apt-get install -y curl make telnet && \
    rm -rf /var/lib/apt/lists/*

COPY pom.xml ./

# Store project dependencies in the image so make run can reuse them.
RUN mvn -B dependency:resolve

COPY src src

RUN mvn -DskipTests compile
